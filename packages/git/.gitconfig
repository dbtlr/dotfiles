[user]
	name = Drew Butler
	email = hi@dbtlr.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = /Users/${USER}/.gitignore_global

[pull]
	rebase = false

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate
	ps = push
	p = pull
	nb = checkout -b
	d = diff
[push]
	autoSetupRemote = true
