<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is substituted by t3ctl (install) when rendering
     into ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dbtlr.t3.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/share/mise/shims/bun</string>
		<string>__HOME__/.bun/bin/t3</string>
		<string>serve</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.bun/bin:__HOME__/.local/share/mise/shims:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>ATLAS_PATH</key>
		<string>__ATLAS_PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/t3code/serve.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/t3code/serve.log</string>
</dict>
</plist>
