<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is substituted by t3ctl (install) when rendering
     into ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dbtlr.t3.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/mise</string>
		<string>x</string>
		<string>--</string>
		<string>t3</string>
		<string>serve</string>
		<string>--mode</string>
		<string>web</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>7333</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ATLAS_PATH</key>
		<string>__ATLAS_PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/t3code/serve.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/t3code/serve.log</string>
</dict>
</plist>
