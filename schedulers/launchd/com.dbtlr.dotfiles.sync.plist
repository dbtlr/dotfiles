<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is substituted by `dot install` (install_schedulers)
     when rendering into ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dbtlr.dotfiles.sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/dotfiles/bin/dot</string>
		<string>sync</string>
		<string>--auto</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>WorkingDirectory</key>
	<string>__HOME__/dotfiles</string>
	<key>StandardOutPath</key>
	<string>__HOME__/dotfiles/state/log/sync.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/dotfiles/state/log/sync.log</string>
</dict>
</plist>
