<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is substituted by `dot install` (install_schedulers)
     when rendering into ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dbtlr.dotfiles.upgrade</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/dotfiles/bin/dot</string>
		<string>upgrade</string>
		<string>--auto</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>WorkingDirectory</key>
	<string>__HOME__/dotfiles</string>
	<key>StandardOutPath</key>
	<string>__HOME__/dotfiles/state/log/upgrade.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/dotfiles/state/log/upgrade.log</string>
</dict>
</plist>
