# Managed by dotfiles (schedulers/systemd/) — installed to
# ~/.config/systemd/user/ by `dot install`.
[Unit]
Description=dot upgrade (unattended bucket)

[Service]
Type=oneshot
ExecStart=%h/dotfiles/bin/dot upgrade --auto
StandardOutput=append:%h/dotfiles/state/log/upgrade.log
StandardError=append:%h/dotfiles/state/log/upgrade.log
