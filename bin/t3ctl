#!/usr/bin/env bash
# t3ctl — manage the com.dbtlr.t3.serve launchd agent.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

LABEL=com.dbtlr.t3.serve
PORT=7333
TEMPLATE="$DOTFILES_DIR/schedulers/launchd/$LABEL.plist"
DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/t3code/serve.log"
URL=https://t3.valhalla.local

red()    { printf '\033[0;31m✗ %s\033[0m\n' "$*"; }
green()  { printf '\033[0;32m✓ %s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m! %s\033[0m\n' "$*"; }

domain() { echo "gui/$(id -u)/$LABEL"; }

is_loaded() { launchctl print "$(domain)" >/dev/null 2>&1; }

rotate_log() {
  if [ -f "$LOG" ] && [ "$(stat -f%z "$LOG" 2>/dev/null || echo 0)" -gt 10485760 ]; then
    mv "$LOG" "$LOG.old"
  fi
}

cmd_install() {
  if [ ! -f "$TEMPLATE" ]; then
    red "template not found: $TEMPLATE"
    exit 1
  fi
  mkdir -p "$(dirname "$LOG")" "$HOME/Library/LaunchAgents"
  rotate_log
  sed "s|__HOME__|$HOME|g" "$TEMPLATE" > "$DEST.tmp"
  mv "$DEST.tmp" "$DEST"
  launchctl bootout "$(domain)" 2>/dev/null || true

  local attempt loaded=0
  for attempt in 1 2; do
    if launchctl bootstrap "gui/$(id -u)" "$DEST"; then loaded=1; break; fi
    yellow "bootstrap attempt $attempt failed, retrying"
    sleep 1
  done
  if [ "$loaded" -eq 1 ]; then
    green "launchd agent loaded: $LABEL"
  else
    red "could not load $LABEL — load manually: launchctl bootstrap gui/$(id -u) $DEST"
    exit 1
  fi
}

cmd_uninstall() {
  launchctl bootout "$(domain)" 2>/dev/null || true
  rm -f "$DEST"
  green "uninstalled: $LABEL"
}

cmd_start() {
  if [ ! -f "$DEST" ]; then
    red "$DEST not found"
    yellow "run t3ctl install first"
    exit 1
  fi
  if is_loaded; then
    yellow "already loaded: $LABEL"
    return
  fi
  rotate_log
  launchctl bootstrap "gui/$(id -u)" "$DEST"
  green "started: $LABEL"
}

cmd_stop() {
  if ! is_loaded; then
    yellow "not loaded: $LABEL"
    return
  fi
  launchctl bootout "$(domain)"
  green "stopped: $LABEL"
}

cmd_restart() {
  if is_loaded; then
    launchctl kickstart -k "$(domain)"
    green "restarted: $LABEL"
  else
    yellow "not loaded — starting instead"
    cmd_start
  fi
}

cmd_status() {
  local out pid state
  if out="$(launchctl print "$(domain)" 2>/dev/null)"; then
    pid="$(printf '%s\n' "$out" | grep -m1 'pid = ' | awk '{print $NF}' || true)"
    state="$(printf '%s\n' "$out" | grep -m1 'state = ' | awk '{print $NF}' || true)"
    green "loaded (state=${state:-unknown}, pid=${pid:-none})"
  else
    red "not loaded: $LABEL"
  fi

  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    green "port $PORT: listening"
  else
    yellow "port $PORT: not listening"
  fi

  local ver
  if ver="$("$HOME/.local/bin/mise" x -- t3 --version 2>/dev/null)"; then
    green "t3 version: $ver"
  else
    yellow "t3 version: unavailable"
  fi

  echo "url: $URL"
}

cmd_logs() {
  if [ ! -f "$LOG" ]; then
    red "no log file at $LOG"
    exit 1
  fi
  if [ "${1:-}" = "-f" ]; then
    tail -n 50 -f "$LOG"
  else
    tail -n 100 "$LOG"
  fi
}

cmd_pair() {
  if [ ! -f "$LOG" ]; then
    red "no log file at $LOG"
    exit 1
  fi
  local line
  line="$(grep -inE 'pair' "$LOG" | tail -n 1 | cut -d: -f1 || true)"
  if [ -z "$line" ]; then
    yellow "no pairing info found in log"
    return
  fi
  tail -n "+$line" "$LOG" | head -n 30
}

cmd_url() {
  echo "$URL"
  echo "http://127.0.0.1:$PORT"
}

usage() {
  cat <<EOF
t3ctl — manage the $LABEL launchd agent

Usage: t3ctl <command>

Commands:
  install     Render the plist and load the launchd agent
  uninstall   Unload the agent and remove the rendered plist
  start       Load the agent if not already running
  stop        Unload the agent (KeepAlive means bootout is the real stop)
  restart     Kickstart the running agent, or start it if not loaded
  status      Show load state, pid, port, t3 version, and URL
  logs [-f]   Tail the last 100 lines, or follow with -f
  pair        Show recent pairing details from the log
  url         Print the service URL
EOF
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift || true
  case "$cmd" in
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_restart ;;
    status)    cmd_status ;;
    logs)      cmd_logs "$@" ;;
    pair)      cmd_pair ;;
    url)       cmd_url ;;
    *)         usage; exit 1 ;;
  esac
}

main "$@"
