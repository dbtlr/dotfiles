#!/usr/bin/env bash
# dot — single entry point for managing this machine's dotfiles.
# Plain bash on purpose: must work when zsh is broken or not yet installed.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$DOTFILES_DIR/packages"

# mise lives in ~/.local/bin and exposes its tools via shims. This script runs
# in plain bash (no `mise activate`), so put both on PATH up front: install
# needs the mise binary, doctor/upgrade need to see mise-managed tools
# (e.g. starship on Linux) the same way an interactive shell does.
# Also add both brew bin dirs: launchd/systemd give a minimal PATH, so
# unattended runs won't resolve brew otherwise.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

case "$(uname -s)" in
  Darwin) DOTFILES_OS="macos" ;;
  Linux)  DOTFILES_OS="linux" ;;
  *)      DOTFILES_OS="unknown" ;;
esac

red()    { printf '\033[0;31m✗ %s\033[0m\n' "$*"; }
green()  { printf '\033[0;32m✓ %s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m! %s\033[0m\n' "$*"; }

# Host package selection seam (spec: hosts.conf). OS-conditional for now.
packages_for_host() {
  local d pkg
  for d in "$PACKAGES_DIR"/*/; do
    pkg="$(basename "$d")"
    case "$pkg" in
      mise-linux) [ "$DOTFILES_OS" = "linux" ] || continue ;;
    esac
    echo "$pkg"
  done
}

cmd_apply() {
  command -v stow >/dev/null || { red "GNU stow is not installed"; exit 1; }
  local pkg src rel target stamp
  for pkg in $(packages_for_host); do
    # Fresh machines ship skeleton files (.bashrc, .profile, ...); stow
    # refuses to replace real files, so move obstructions aside first.
    # Dated suffix: repeated applies (e.g. sync's auto-revert) never clobber
    # an earlier backup.
    while IFS= read -r src; do
      rel="${src#"$PACKAGES_DIR/$pkg/"}"
      target="$HOME/$rel"
      if { [ -e "$target" ] || [ -L "$target" ]; } && [ ! "$target" -ef "$src" ]; then
        stamp="$(date +%Y%m%d-%H%M%S)"
        yellow "moved aside: ~/$rel -> ~/$rel.backup-$stamp"
        mv "$target" "$target.backup-$stamp"
      fi
    done < <(find "$PACKAGES_DIR/$pkg" -type f)
    stow --no-folding -d "$PACKAGES_DIR" -t "$HOME" -R "$pkg"
    green "stowed $pkg"
  done
  render_starship
  render_init_cache
}

render_starship() {
  local src="$PACKAGES_DIR/starship/.config/starship"
  local host; host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
  local frag="$src/hosts/$host.toml"
  local out="$HOME/.config/starship.toml"
  mkdir -p "$HOME/.config"
  # Generated file: real file, not a stow symlink (per-host artifact)
  [ -L "$out" ] && rm "$out"
  {
    echo "# GENERATED by 'dot apply' — edit packages/starship/, not this file"
    if [ -f "$frag" ]; then
      sed "s/^palette = .*/palette = '$host'/" "$src/base.toml"
      echo   # guard: fragment must start on its own line
      cat "$frag"
    else
      cat "$src/base.toml"
    fi
  } > "$out.tmp"
  mv "$out.tmp" "$out"   # atomic: never leave a truncated live prompt config
  green "rendered starship.toml ($([ -f "$frag" ] && echo "$host palette" || echo 'base only'))"
}

render_init_cache() {
  local dir="$DOTFILES_DIR/state/init"
  mkdir -p "$dir"
  # Each cache = captured output of an init eval. Shell modules source these
  # and only fork the real tool when the cache is missing.
  # Known tradeoff: caches embed resolved binary paths (e.g. starship via mise
  # on Linux), so an out-of-band `mise upgrade`/`mise uninstall` can leave them
  # stale until the next `dot apply` or `dot upgrade` regenerates
  # them (the dotfiles-managed flow always regenerates).
  # Atomic writes (tmp + mv, same pattern as render_starship): a shell starting
  # mid-regeneration must never source a truncated cache.
  local f
  f="$dir/brew.zsh"
  if command -v brew >/dev/null; then
    if brew shellenv zsh > "$f.tmp" 2>/dev/null; then mv "$f.tmp" "$f"; else rm -f "$f.tmp" "$f"; fi
  else
    rm -f "$f"
  fi
  f="$dir/mise.zsh"
  if command -v mise >/dev/null; then
    # `mise activate` emits a verbatim snapshot of the generating PATH
    # (export PATH='…') — a no-op when eval'd live, but it would clobber the
    # interactive shell's PATH when sourced from cache. Strip it; the precmd
    # hook manages PATH dynamically.
    if mise activate zsh 2>/dev/null | grep -v '^export PATH=' > "$f.tmp"; then
      mv "$f.tmp" "$f"
    else
      rm -f "$f.tmp" "$f"
    fi
  else
    rm -f "$f"
  fi
  f="$dir/zoxide.zsh"
  if command -v zoxide >/dev/null; then
    if zoxide init zsh > "$f.tmp" 2>/dev/null; then mv "$f.tmp" "$f"; else rm -f "$f.tmp" "$f"; fi
  else
    rm -f "$f"
  fi
  f="$dir/starship.zsh"
  if command -v starship >/dev/null; then
    if starship init zsh --print-full-init > "$f.tmp" 2>/dev/null; then mv "$f.tmp" "$f"; else rm -f "$f.tmp" "$f"; fi
  else
    rm -f "$f"
  fi
  green "rendered init caches"
}

cmd_doctor() {
  local failures=0

  # 1. Required tools
  local tool
  for tool in stow git zsh mise starship; do
    if command -v "$tool" >/dev/null; then
      green "$tool present"
    else
      red "$tool missing"
      failures=$((failures + 1))
    fi
  done

  # Vendored plugins present? (submodules need init after a plain clone)
  if [ -f "$DOTFILES_DIR/vendor/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    green "vendor submodules initialized"
  else
    red "vendor submodules missing (run: dot install)"
    failures=$((failures + 1))
  fi

  # 2. Every file in every host package is correctly symlinked into ~
  local pkg src rel target missing
  for pkg in $(packages_for_host); do
    missing=0
    while IFS= read -r src; do
      rel="${src#"$PACKAGES_DIR/$pkg/"}"
      target="$HOME/$rel"
      # -ef: target resolves to the same inode as the package file (works on macOS + Linux)
      if [ ! -L "$target" ] || [ ! "$target" -ef "$src" ]; then
        missing=$((missing + 1))
      fi
    done < <(find "$PACKAGES_DIR/$pkg" -type f)
    if [ "$missing" -eq 0 ]; then
      green "package '$pkg' fully stowed"
    else
      red "package '$pkg': $missing file(s) not stowed (run: dot apply)"
      failures=$((failures + 1))
    fi
  done

  # 3. Dangling symlinks in ~ and ~/.config that point into the repo
  local link
  while IFS= read -r link; do
    case "$(readlink "$link")" in
      *dotfiles*) yellow "dangling symlink: $link -> $(readlink "$link")"
                  failures=$((failures + 1)) ;;
    esac
  done < <(find "$HOME" -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null;
           find "$HOME/.config" -maxdepth 3 -type l ! -exec test -e {} \; -print 2>/dev/null)

  # 4. Default shell
  case "${SHELL:-}" in
    *zsh) green "default shell is zsh" ;;
    *)    yellow "default shell is not zsh (${SHELL:-unset})" ;;
  esac

  # 5. Legacy leftovers from the pre-rebuild setup
  if [ -d "$HOME/.oh-my-zsh" ]; then
    yellow "legacy oh-my-zsh directory remains (rm -rf ~/.oh-my-zsh)"
  fi

  # 6. Recovery escape hatch (~/.zshrc.fallback, see docs/RECOVERY.md):
  # missing means no safety net; differing from the live zshrc means it
  # predates proven changes and would recover to a stale config.
  if [ ! -f "$HOME/.zshrc.fallback" ]; then
    yellow "no ~/.zshrc.fallback — create one while the shell is healthy: cp -L ~/.zshrc ~/.zshrc.fallback"
  elif [ -f "$HOME/.zshrc" ] && ! cmp -s "$HOME/.zshrc.fallback" "$HOME/.zshrc"; then
    yellow "~/.zshrc.fallback is stale (differs from ~/.zshrc) — refresh after proven changes: cp -L ~/.zshrc ~/.zshrc.fallback"
  else
    green "fallback zshrc present and current"
  fi

  # 7. apply's moved-aside backups accumulating (each blocked stow target
  # leaves a dated *.backup-* file; a few are normal, a pile means cruft)
  local backups
  backups="$({ find "$HOME" -maxdepth 1 -name '*.backup-*' 2>/dev/null;
               find "$HOME/.config" -maxdepth 2 -name '*.backup-*' 2>/dev/null; } | wc -l | tr -d '[:space:]')"
  if [ "$backups" -gt 5 ]; then
    yellow "$backups *.backup-* files under ~ / ~/.config — review and delete the stale ones"
  fi

  # 8. Divergence from origin/main as of the LAST FETCH — informational,
  # deliberately offline (sync owns fetching; doctor never touches the network)
  local ahead behind
  if git -C "$DOTFILES_DIR" rev-parse --verify -q origin/main >/dev/null 2>&1; then
    ahead="$(git -C "$DOTFILES_DIR" rev-list --count origin/main..HEAD 2>/dev/null || echo '?')"
    behind="$(git -C "$DOTFILES_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
    if [ "$ahead" = "0" ] && [ "$behind" = "0" ]; then
      green "in sync with origin/main (as of last fetch)"
    else
      yellow "diverged from origin/main: ahead $ahead, behind $behind (as of last fetch — next sync converges)"
    fi
  fi

  # 9. Schedulers. Neither loaded is a valid state (pre-enablement: the
  # install key-turn hasn't happened) — yellow. Exactly one loaded means a
  # half-configured machine — red.
  local sched_loaded=0 sched_missing="" unit
  if [ "$DOTFILES_OS" = "macos" ]; then
    for unit in com.dbtlr.dotfiles.sync com.dbtlr.dotfiles.upgrade; do
      if launchctl print "gui/$(id -u)/$unit" >/dev/null 2>&1; then
        sched_loaded=$((sched_loaded + 1))
      else
        sched_missing="$sched_missing $unit"
      fi
    done
  elif [ "$DOTFILES_OS" = "linux" ]; then
    for unit in dotfiles-sync.timer dotfiles-upgrade.timer; do
      if systemctl --user is-enabled "$unit" >/dev/null 2>&1; then
        sched_loaded=$((sched_loaded + 1))
      else
        sched_missing="$sched_missing $unit"
      fi
    done
  fi
  if [ "$DOTFILES_OS" != "unknown" ]; then
    if [ "$sched_loaded" -eq 2 ]; then
      green "schedulers loaded (sync + upgrade)"
    elif [ "$sched_loaded" -eq 0 ]; then
      yellow "schedulers not enabled (run: dot install when ready to enable)"
    else
      red "schedulers half-configured: missing$sched_missing (run: dot install)"
      failures=$((failures + 1))
    fi
  fi

  # 10. Rendered schedulers still pointing at the pre-rename binary (M6: the
  # bin/dotfiles shim keeps them working, but they should be re-rendered).
  # Absent files are fine — pre-enablement, nothing rendered yet.
  local rendered
  for rendered in "$HOME/Library/LaunchAgents/com.dbtlr.dotfiles.sync.plist" \
                  "$HOME/Library/LaunchAgents/com.dbtlr.dotfiles.upgrade.plist" \
                  "$HOME/.config/systemd/user/dotfiles-sync.service" \
                  "$HOME/.config/systemd/user/dotfiles-upgrade.service"; do
    [ -f "$rendered" ] || continue
    if grep -q 'bin/dotfiles' "$rendered"; then
      yellow "$(basename "$rendered") still runs bin/dotfiles — re-run: dot install (re-renders schedulers for the dot rename)"
    fi
  done

  # 11. Scheduler logs growing unbounded (sync/upgrade self-trim at 512KB;
  # >1MB here means the self-trim isn't running — warn as the backstop)
  local log size
  for log in "$DOTFILES_DIR"/state/log/*.log; do
    [ -f "$log" ] || continue
    size="$(wc -c < "$log" | tr -d '[:space:]')"
    if [ "$size" -gt 1048576 ]; then
      yellow "$(basename "$log") is $((size / 1024))KB (>1MB) — truncate with: : > $log"
    fi
  done

  if [ "$failures" -eq 0 ]; then
    green "doctor: all checks passed"
  else
    red "doctor: $failures problem(s) found"
    return 1
  fi
}

cmd_upgrade() {
  local auto=0
  [ "${1:-}" = "--auto" ] && auto=1

  # Shares the sync run lock: scheduler-vs-manual (or sync-vs-upgrade) overlap
  # would race git and the init caches. Trap releases the lock on any exit.
  trap _run_exit_trap EXIT
  acquire_run_lock || return 0
  trim_log upgrade

  mkdir -p "$DOTFILES_DIR/state"
  local failures=0

  # --- Auto bucket (no sudo, safe unattended) ---

  if command -v mise >/dev/null; then
    mise self-update -y >/dev/null 2>&1 || true   # no-op when not self-managed
    if mise upgrade; then green "mise tools upgraded"; else red "mise upgrade failed"; failures=$((failures+1)); fi
  fi

  if git -C "$DOTFILES_DIR" submodule update --remote --depth 1; then
    green "vendor plugins updated"
  else
    red "vendor plugin update failed"; failures=$((failures+1))
  fi

  if [ "$DOTFILES_OS" = "macos" ]; then
    if brew update >/dev/null 2>&1 && brew upgrade --formula; then
      green "brew formulae upgraded"
    else
      red "brew formula upgrade failed"; failures=$((failures+1))
    fi
    local casks
    casks="$(brew outdated --cask --quiet 2>/dev/null | grep -c . || true)"
    if [ "$auto" -eq 1 ]; then
      [ "$casks" -gt 0 ] && yellow "$casks cask(s) outdated — run: dot upgrade"
    else
      # --- Manual bucket: casks ---
      if [ "$casks" -gt 0 ]; then
        if brew upgrade --cask; then
          casks=0
          green "casks upgraded"
        else
          red "cask upgrade failed"; failures=$((failures+1))
        fi
      else
        green "casks up to date"
      fi
    fi
    printf 'casks_outdated=%s\n' "$casks" > "$DOTFILES_DIR/state/outdated"
  else
    local debs
    # sudo-free count: relies on the apt-daily timers keeping package lists fresh
    debs="$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst' || true)"
    if [ "$auto" -eq 1 ]; then
      [ "$debs" -gt 0 ] && yellow "$debs apt package(s) upgradable — run: dot upgrade"
    else
      # --- Manual bucket: apt (interactive sudo) ---
      if sudo apt-get update && sudo apt-get upgrade -y; then
        debs=0
        green "apt packages upgraded"
      else
        red "apt upgrade failed"; failures=$((failures+1))
      fi
    fi
    printf 'apt_upgradable=%s\n' "$debs" > "$DOTFILES_DIR/state/outdated"
  fi

  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$([ "$failures" -eq 0 ] && echo ok || echo "failed=$failures")" \
    > "$DOTFILES_DIR/state/last-upgrade"

  # Upgrades can change tool init scripts — refresh the cached evals.
  render_init_cache

  [ "$failures" -eq 0 ] && return 0 || return 1
}

# --- sync: the converge loop (spec: commit -> pull --rebase -> push ->
# apply -> manifest installs -> smoke test with auto-revert) ---

# Overridable for tests (fixture harness sets 0 so fresh writes don't trip it).
QUIET_PERIOD_MINS="${DOTFILES_QUIET_MINS:-30}"

_SYNC_STATE_WRITTEN=0
_SYNC_ACTIVE=0
_RUN_LOCK_DIR=""

_sync_state() {  # _sync_state <status> <detail...>
  mkdir -p "$DOTFILES_DIR/state"
  printf '%s %s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" "${*:2}" > "$DOTFILES_DIR/state/last-sync"
  _SYNC_STATE_WRITTEN=1
}

# Never-silent deaths: under set -e any command failure between cmd_sync's
# start and its first _sync_state write would otherwise exit without a trace
# in last-sync (status would lie with the previous run's record). The EXIT
# trap backfills a red 'failed' state. Doubles as the run-lock release point
# for both sync and upgrade.
_run_exit_trap() {
  local rc=$?
  if [ "$_SYNC_ACTIVE" = "1" ] && [ "$_SYNC_STATE_WRITTEN" != "1" ] && [ "$rc" -ne 0 ]; then
    _sync_state failed "sync died unexpectedly (see state/log)" || true
  fi
  if [ -n "$_RUN_LOCK_DIR" ]; then
    rm -rf "$_RUN_LOCK_DIR"
  fi
}

# Keep scheduler logs bounded: launchd/systemd append forever, so each run
# trims its own verb's log once it crosses 512KB (keeping the last 500 lines).
# Truncate IN PLACE (cat > log, not mv): the scheduler holds an O_APPEND fd on
# this very file for the current run's output — replacing the inode would
# orphan it. Doctor's >1MB warning stays as the backstop.
trim_log() {  # trim_log <sync|upgrade>
  local log="$DOTFILES_DIR/state/log/$1.log" size
  [ -f "$log" ] || return 0
  size="$(wc -c < "$log" | tr -d '[:space:]')"
  if [ "$size" -gt 524288 ]; then
    tail -n 500 "$log" > "$log.tmp" && cat "$log.tmp" > "$log"
    rm -f "$log.tmp"
  fi
}

# Cross-run mutual exclusion for sync/upgrade (scheduler + manual overlap).
# mkdir is the portable atomic primitive — flock(1) doesn't exist on macOS.
# Returns 1 when another live run holds the lock (callers exit 0: a missed
# scheduled run is cheap); stale locks (dead pid) are reclaimed.
acquire_run_lock() {
  local lock="$DOTFILES_DIR/state/run.lock" pid
  mkdir -p "$DOTFILES_DIR/state"
  if ! mkdir "$lock" 2>/dev/null; then
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      yellow "another dot run in progress (pid $pid) — skipping"
      return 1
    fi
    rm -rf "$lock"   # stale: owner is gone
    if ! mkdir "$lock" 2>/dev/null; then
      yellow "could not acquire run lock ($lock) — skipping"
      return 1
    fi
  fi
  echo $$ > "$lock/pid"
  _RUN_LOCK_DIR="$lock"
}

_recently_edited() {
  # Any tracked-or-untracked (non-ignored) file modified within the quiet period?
  # 0 disables the guard entirely (BSD find treats `-mmin -0` as matching
  # fresh files, so don't let it near find).
  if [ "$QUIET_PERIOD_MINS" -le 0 ] 2>/dev/null; then return 1; fi
  # -z: NUL-delimited, paths verbatim (no quoting, spaces survive). Tokens are
  # "XY <path>", except a rename emits its second path as a bare extra token —
  # so try each token both prefix-stripped and raw, and stat whichever exists.
  local entry f
  while IFS= read -r -d '' entry; do
    for f in "${entry:3}" "$entry"; do
      [ -n "$f" ] || continue
      [ -f "$DOTFILES_DIR/$f" ] || continue
      if [ -n "$(find "$DOTFILES_DIR/$f" -mmin "-$QUIET_PERIOD_MINS" 2>/dev/null)" ]; then
        return 0
      fi
    done
  done < <(git -C "$DOTFILES_DIR" status --porcelain -z)
  return 1
}

cmd_sync() {
  local auto=0
  [ "${1:-}" = "--auto" ] && auto=1

  # Cross-run lock + never-silent-death trap (the trap also releases the lock).
  trap _run_exit_trap EXIT
  acquire_run_lock || return 0
  _SYNC_ACTIVE=1
  trim_log sync

  # 1. Guards
  if [ -e "$DOTFILES_DIR/.git/rebase-merge" ] || [ -e "$DOTFILES_DIR/.git/rebase-apply" ] || [ -f "$DOTFILES_DIR/.git/MERGE_HEAD" ]; then
    _sync_state blocked "repo mid-rebase/merge"; red "sync blocked: repo mid-rebase/merge"; return 1
  fi
  if [ "$auto" -eq 1 ] && _recently_edited; then
    _sync_state skipped "active edits (<${QUIET_PERIOD_MINS}m)"; yellow "sync skipped: active edits"; return 0
  fi

  # 2. Commit local changes
  if [ -n "$(git -C "$DOTFILES_DIR" status --porcelain)" ]; then
    git -C "$DOTFILES_DIR" add -A
    git -C "$DOTFILES_DIR" commit -m "auto($(hostname -s | tr '[:upper:]' '[:lower:]')): sync $(date '+%Y-%m-%d %H:%M')" \
      || { _sync_state failed "commit failed"; red "sync: commit failed"; return 1; }
    green "committed local changes"
  fi

  local pre_pull
  pre_pull="$(git -C "$DOTFILES_DIR" rev-parse HEAD)"

  # 3. Pull (rebase); conflict => abort untouched + red flag
  if ! git -C "$DOTFILES_DIR" fetch origin main 2>/dev/null; then
    _sync_state offline "fetch failed (offline?)"; yellow "sync: fetch failed (offline?) — will retry"; return 0
  fi

  # 3b. Quarantine: a previous run auto-reverted the commit at origin's tip.
  # While origin still points at it, refuse to pull/apply it again — the red
  # MOTD re-asserts every run instead of a 30-min revert thrash loop. Local
  # commits keep accumulating on main and push once origin moves to a fix.
  local quarantine="$DOTFILES_DIR/state/quarantine" bad_sha=""
  if [ -f "$quarantine" ]; then
    read -r bad_sha < "$quarantine" || true
    if [ -n "$bad_sha" ] && [ "$(git -C "$DOTFILES_DIR" rev-parse origin/main)" = "$bad_sha" ]; then
      if [ "$(git -C "$DOTFILES_DIR" rev-list --count origin/main..HEAD)" -gt 0 ]; then
        yellow "push deferred (quarantine active)"
      fi
      _sync_state reverted "bad commit $bad_sha still at origin tip — fix and push"
      red "sync: bad commit $bad_sha still at origin tip — fix and push (not re-applying)"
      return 1
    fi
  fi

  # 3c. Smoke-gate UNPUSHED work, not just this run's commit: a broken commit
  # blocked on a previous run leaves the tree clean but the branch ahead — it
  # must still prove itself (live, symlinked config) before it may propagate.
  # Placed after the fetch (origin/main is fresh) and after the quarantine
  # check (a quarantined tip returns above — that red state wins). When ahead
  # is 0 there is nothing to push, so the gate stays out of the way: pulls
  # must never be blocked by local breakage — the fix has to be able to land
  # (post-pull smoke + auto-revert covers the receiving side).
  if [ "$(git -C "$DOTFILES_DIR" rev-list --count origin/main..HEAD)" -gt 0 ] \
      && ! "$DOTFILES_DIR/bin/zsh-smoke-test" 60; then
    _sync_state failed "local config fails smoke test — not propagating"
    red "sync: local config fails smoke test — not propagating (commits stay local)"
    return 1
  fi

  if ! git -C "$DOTFILES_DIR" pull --rebase origin main; then
    git -C "$DOTFILES_DIR" rebase --abort 2>/dev/null || true
    _sync_state conflict "rebase conflict — resolve manually"
    red "sync BLOCKED: rebase conflict — resolve manually in $DOTFILES_DIR"
    return 1
  fi

  # 4. Push (tolerant)
  if [ "$(git -C "$DOTFILES_DIR" rev-list --count origin/main..HEAD)" -gt 0 ]; then
    if git -C "$DOTFILES_DIR" push origin main; then
      green "pushed"
    elif [ -f "$quarantine" ]; then
      yellow "push deferred (quarantine active)"
    else
      yellow "push failed (offline?) — will retry next run"
    fi
  fi

  # 5-7. Apply + manifest installs + smoke/auto-revert, only if the pull moved us
  local post_pull changed
  post_pull="$(git -C "$DOTFILES_DIR" rev-parse HEAD)"
  if [ "$post_pull" != "$pre_pull" ]; then
    changed="$(git -C "$DOTFILES_DIR" diff --name-only "$pre_pull" "$post_pull")"
    cmd_apply
    git -C "$DOTFILES_DIR" submodule update --init --depth 1

    if echo "$changed" | grep -Eq '^packages/mise(-linux)?/.*\.toml'; then
      mise install && green "mise tools installed (manifest changed)" || yellow "mise install failed"
    fi
    if [ "$DOTFILES_OS" = "macos" ] && echo "$changed" | grep -q 'manifests/Brewfile'; then
      brew bundle --no-upgrade --file="$DOTFILES_DIR/manifests/Brewfile" && green "brew bundle applied" || yellow "brew bundle failed"
    fi
    if [ "$DOTFILES_OS" = "linux" ] && echo "$changed" | grep -q 'manifests/apt-packages.txt'; then
      yellow "apt manifest changed — run: dot install (sudo required)"
    fi

    # Smoke test + auto-revert + quarantine. Revert stays ON main (checkout -B
    # resets the branch, no detached HEAD): local work keeps landing on main
    # and survives; the quarantined origin tip is what we refuse to re-pull.
    if ! "$DOTFILES_DIR/bin/zsh-smoke-test" 60; then
      local bad_tip
      bad_tip="$(git -C "$DOTFILES_DIR" rev-parse origin/main)"
      red "smoke test FAILED after applying $post_pull — auto-reverting to $pre_pull"
      git -C "$DOTFILES_DIR" checkout -B main "$pre_pull" 2>/dev/null
      printf '%s\n' "$bad_tip" > "$quarantine"
      cmd_apply
      if "$DOTFILES_DIR/bin/zsh-smoke-test" 60; then
        _sync_state reverted "bad commit $bad_tip — reverted to $pre_pull; fix and push"
        red "auto-reverted: $bad_tip broke the shell (main reset to $pre_pull; quarantined until origin moves)"
      else
        _sync_state broken "smoke fails even after revert — manual intervention"
        red "sync: shell broken even after revert — see docs/RECOVERY.md"
      fi
      return 1
    fi
    rm -f "$quarantine"
    _sync_state ok "pulled $(git -C "$DOTFILES_DIR" rev-list --count "$pre_pull".."$post_pull") commit(s), applied"
  else
    rm -f "$quarantine"   # converged on a non-quarantined tip — nothing left to prove
    _sync_state ok "up to date"
  fi
  green "sync ok"
  _SYNC_ACTIVE=0
}

# Days since a YYYY-MM-DD date (BSD vs GNU date), "?" if unparseable.
age_days() {
  local ts
  if [ "$DOTFILES_OS" = "macos" ]; then
    ts="$(date -j -f '%Y-%m-%d' "$1" '+%s' 2>/dev/null || true)"
  else
    ts="$(date -d "$1" '+%s' 2>/dev/null || true)"
  fi
  if [ -n "$ts" ]; then echo "$(( ($(date '+%s') - ts) / 86400 ))"; else echo "?"; fi
}

# Minutes since an ISO-8601 timestamp (as written by _sync_state), "?" if unparseable.
age_mins() {
  local ts
  if [ "$DOTFILES_OS" = "macos" ]; then
    ts="$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$1" '+%s' 2>/dev/null || true)"
  else
    ts="$(date -d "$1" '+%s' 2>/dev/null || true)"
  fi
  if [ -n "$ts" ]; then echo "$(( ($(date '+%s') - ts) / 60 ))"; else echo "?"; fi
}

cmd_status() {
  local motd=0
  [ "${1:-}" = "--motd" ] && motd=1
  local state="$DOTFILES_DIR/state"
  local host today
  host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
  today="$(date '+%Y-%m-%d')"

  # --- read state (pure file reads; written by upgrade/sync) ---
  local up_date="" up_result="" up_day=""
  [ -f "$state/last-upgrade" ] && read -r up_date up_result < "$state/last-upgrade" || true
  up_day="${up_date:0:10}"

  local out_label="" out_count=""
  [ -f "$state/outdated" ] && IFS='=' read -r out_label out_count < "$state/outdated" || true
  case "$out_label" in
    casks_outdated) out_label="cask(s) outdated" ;;
    apt_upgradable) out_label="apt package(s) upgradable" ;;
  esac

  local sync_ts="" sync_status="" sync_detail=""
  [ -f "$state/last-sync" ] && read -r sync_ts sync_status sync_detail < "$state/last-sync" || true

  # --- classify; red-class lines bypass the MOTD debounce ---
  # Staleness by ISO date string compare against the 3-days-ago cutoff
  # (portable: no GNU date -d arithmetic needed on the upgrade timestamp).
  local cutoff red_failed="" red_stale=""
  if [ "$DOTFILES_OS" = "macos" ]; then
    cutoff="$(date -v-3d '+%Y-%m-%d')"
  else
    cutoff="$(date -d '3 days ago' '+%Y-%m-%d')"
  fi
  case "$up_result" in
    failed*) red_failed="last upgrade failed (${up_result#failed=} step(s)) — run: dot upgrade" ;;
  esac
  if [ -n "$up_day" ] && [[ "$up_day" < "$cutoff" ]]; then
    red_stale="last upgrade $up_day (>3 days ago) — run: dot upgrade"
  fi

  # Sync states: conflict/reverted/broken/failed are red-class (bypass the
  # MOTD debounce); blocked/offline/skipped informational; ok stays quiet.
  local red_sync="" yellow_sync=""
  case "$sync_status" in
    conflict) red_sync="sync conflict: $sync_detail — resolve in $DOTFILES_DIR, then: dot sync" ;;
    reverted) red_sync="sync auto-reverted: $sync_detail (recover: fix the bad commit — here or on another host — and push; this machine un-quarantines on the next sync)" ;;
    broken)   red_sync="sync: $sync_detail — see docs/RECOVERY.md" ;;
    failed)   red_sync="sync failed: $sync_detail" ;;
    blocked|offline|skipped) yellow_sync="sync $sync_status: $sync_detail" ;;
  esac

  # Staleness: schedulers should run sync every ~30 min; >24h of silence means
  # they're not firing. Yellow-class (informational), never bypasses debounce.
  local sync_stale="" sync_age=""
  if [ -n "$sync_ts" ]; then
    sync_age="$(age_mins "$sync_ts")"
    if [ "$sync_age" != "?" ] && [ "$sync_age" -gt 1440 ]; then
      sync_stale="sync: stale (no run in $((sync_age / 60))h) — check schedulers (dot doctor)"
    fi
  fi

  if [ "$motd" -eq 1 ]; then
    # Daily debounce: all-green and already shown today → stay silent.
    local shown=""
    [ -f "$state/motd-shown" ] && read -r shown < "$state/motd-shown" || true
    if [ "$shown" = "$today" ] && [ -z "$red_failed$red_stale$red_sync" ]; then
      return 0
    fi
    # Best effort: an unwritable state dir must not break shell startup
    # (the banner just repeats until the dir is writable again).
    { mkdir -p "$state" && printf '%s\n' "$today" > "$state/motd-shown"; } 2>/dev/null || true

    local accent='\033[0m'
    case "$host" in
      valhalla) accent='\033[0;34m' ;;   # blue
      asgard)   accent='\033[0;31m' ;;   # red (server)
      db-mbp)   accent='\033[0;35m' ;;   # purple (laptop)
    esac
    printf '%b%s · %s · %s\033[0m\n' "$accent" "$host" "$DOTFILES_OS" "$(date '+%A, %B %d, %Y')"
    printf 'Good morning, %s.\n' "${USER:-$(id -un)}"
    [ -n "$red_failed" ] && red "$red_failed"
    [ -n "$red_stale" ] && red "$red_stale"
    [ -n "$red_sync" ] && red "$red_sync"
    if [ -n "$out_count" ] && [ "$out_count" -gt 0 ] 2>/dev/null; then
      yellow "$out_count $out_label — run: dot upgrade"
    fi
    [ -n "$yellow_sync" ] && yellow "$yellow_sync"
    [ -n "$sync_stale" ] && yellow "$sync_stale"
    return 0
  fi

  # --- human view ---
  printf '%s · %s\n' "$host" "$DOTFILES_OS"
  if [ -z "$up_date" ]; then
    yellow "upgrade: no record — run: dot upgrade"
  else
    if [ -n "$red_failed" ]; then red "upgrade: $red_failed"; fi
    if [ -n "$red_stale" ]; then red "upgrade: $red_stale"; fi
    if [ -z "$red_failed$red_stale" ]; then
      green "upgrade: $up_result, $(age_days "$up_day") day(s) ago ($up_date)"
    fi
  fi
  if [ -z "$out_count" ]; then
    yellow "outdated: unknown — run: dot upgrade"
  elif [ "$out_count" -gt 0 ] 2>/dev/null; then
    yellow "outdated: $out_count $out_label — run: dot upgrade"
  else
    green "outdated: none"
  fi
  if [ -z "$sync_status" ]; then
    yellow "sync: no record — run: dot sync"
  elif [ -n "$red_sync" ]; then
    red "$red_sync"
  elif [ -n "$sync_stale" ]; then
    yellow "$sync_stale"
  elif [ -n "$yellow_sync" ]; then
    yellow "$yellow_sync"
  else
    green "sync: synced $(age_mins "$sync_ts")m ago ($sync_detail)"
  fi
}

# Render + load the OS scheduler jobs (launchd agents / systemd user timers).
# ONLY cmd_install calls this: enabling a timed auto-commit of the working
# tree is a conscious key-turn, never a side effect of apply/sync/doctor.
install_schedulers() {
  mkdir -p "$DOTFILES_DIR/state/log"
  if [ "$DOTFILES_OS" = "macos" ]; then
    local label dest attempt loaded
    mkdir -p "$HOME/Library/LaunchAgents"
    for label in com.dbtlr.dotfiles.sync com.dbtlr.dotfiles.upgrade; do
      dest="$HOME/Library/LaunchAgents/$label.plist"
      sed "s|__HOME__|$HOME|g" "$DOTFILES_DIR/schedulers/launchd/$label.plist" > "$dest"
      # Idempotent reload: bootout is a no-op (ignored) when not loaded.
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      # bootstrap can fail transiently (e.g. right after a bootout) — retry
      # once, and tolerate total failure (set -e!) with a manual hint rather
      # than aborting the rest of the install.
      loaded=0
      for attempt in 1 2; do
        if launchctl bootstrap "gui/$(id -u)" "$dest"; then loaded=1; break; fi
        sleep 1
      done
      if [ "$loaded" -eq 1 ]; then
        green "launchd agent loaded: $label"
      else
        yellow "could not load $label — load manually: launchctl bootstrap gui/$(id -u) $dest"
      fi
    done
  elif [ "$DOTFILES_OS" = "linux" ]; then
    mkdir -p "$HOME/.config/systemd/user"
    cp "$DOTFILES_DIR/schedulers/systemd/dotfiles-sync.service" \
       "$DOTFILES_DIR/schedulers/systemd/dotfiles-sync.timer" \
       "$DOTFILES_DIR/schedulers/systemd/dotfiles-upgrade.service" \
       "$DOTFILES_DIR/schedulers/systemd/dotfiles-upgrade.timer" \
       "$HOME/.config/systemd/user/"
    systemctl --user daemon-reload
    systemctl --user enable --now dotfiles-sync.timer dotfiles-upgrade.timer
    # Headless server: user timers stop at logout unless the user lingers.
    loginctl enable-linger "$USER" 2>/dev/null \
      || yellow "could not enable lingering — timers stop at logout (run: sudo loginctl enable-linger $USER)"
    green "systemd user timers enabled: dotfiles-sync, dotfiles-upgrade"
  fi
}

cmd_install() {
  if [ "$DOTFILES_OS" = "macos" ]; then
    if ! command -v brew >/dev/null; then
      yellow "Installing Homebrew..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      eval "$("$([ -x /opt/homebrew/bin/brew ] && echo /opt/homebrew/bin/brew || echo /usr/local/bin/brew)" shellenv)"
    fi
    brew bundle --file="$DOTFILES_DIR/manifests/Brewfile"
  else
    sudo apt-get update
    { grep -vE '^\s*(#|$)' "$DOTFILES_DIR/manifests/apt-packages.txt" || true; } | xargs -r sudo apt-get install -y

    # Unattended security upgrades (asgard). Config copied under a -dotfiles
    # suffix so the distro's own 50unattended-upgrades isn't clobbered;
    # 20auto-upgrades holds the canonical Periodic switches. Idempotent.
    sudo apt-get install -y unattended-upgrades
    sudo cp "$DOTFILES_DIR/manifests/50unattended-upgrades" /etc/apt/apt.conf.d/50unattended-upgrades-dotfiles
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' \
      | sudo tee /etc/apt/apt.conf.d/20auto-upgrades >/dev/null
    green "unattended-upgrades configured (security-only)"
  fi

  cmd_apply

  # Vendored zsh plugins (vendor/ submodules)
  git -C "$DOTFILES_DIR" submodule update --init --depth 1

  # mise
  if ! command -v mise >/dev/null; then
    curl -fsSL https://mise.run | sh
  fi

  mise install

  # Default shell
  local zsh_path
  zsh_path="$(command -v zsh || true)"
  if [ -n "$zsh_path" ] && [[ ! "${SHELL:-}" =~ zsh$ ]]; then
    yellow "Setting default shell to zsh ($zsh_path)"
    chsh -s "$zsh_path" "$USER" 2>/dev/null \
      || sudo chsh -s "$zsh_path" "$USER" \
      || yellow "Could not change shell automatically; run: chsh -s $zsh_path"
  fi

  install_schedulers

  green "install complete — restart your shell or run: exec zsh"
}

usage() {
  cat <<'EOF'
dot — manage this machine's dotfiles

Usage: dot <command>

Commands:
  install   Bootstrap dependencies and stow packages (idempotent)
  apply     Stow all packages into ~ (restow-safe)
  doctor    Check health: tools, symlinks, default shell
  upgrade   Upgrade dependencies (--auto: unattended bucket only)
  sync      Converge with origin: commit, pull --rebase, push, apply, smoke-test
            (--auto: scheduled run — skips when files were edited recently)
  status    Show machine status (--motd: daily banner for shell startup)
  help      Show this help
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    install) cmd_install "$@" ;;
    apply)   cmd_apply "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    sync)    cmd_sync "$@" ;;
    status)  cmd_status "$@" ;;
    help|-h|--help) usage ;;
    *) red "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
